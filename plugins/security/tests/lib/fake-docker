#!/usr/bin/env bash
# 테스트용 가짜 docker — 환경 변수로 동작을 바꾼다.
#   FAKE_INFO_FAIL=1         docker info 실패 (엔진 꺼짐)
#   FAKE_COMPOSE=<버전>       docker compose version --short 출력 (빈 값이면 실패)
#   FAKE_COMPONENTS=<문자열>  docker version 의 서버 구성요소
#   FAKE_MEM=<bytes>          docker info MemTotal
#   FAKE_IMAGES=<ref ...>     docker image inspect 가 성공하는 이미지
#   build (update.sh 로컬 빌드): FAKE_BUILD_STATE=<파일> 에 "<태그> <ID> <build-input 라벨> <version 라벨>" 을 남기고
#                       그 태그·ID 를 inspect 가능하게 한다. --iidfile 에 ID 를 쓴다
#                       FAKE_BUILD_ID=<sha256:…> 빌드 결과 ID · FAKE_BUILD_RC=<n> 빌드 실패 · FAKE_BUILD_LABEL=<값> 입력 라벨을 다른 값으로
#                       FAKE_BUILD_NO_IIDFILE=1 iidfile 을 쓰지 않음
#   FAKE_LOG=<파일>           호출 기록
#   FAKE_RUN_OUTPUT=<문자열>  docker run 이 출력할 내용 (설정하지 않으면 run 은 실패 99)
#   FAKE_RUN_FAIL_MATCH=<문자열> FAKE_RUN_FAIL_RC=<n>
#                            인자에 문자열이 들어간 docker run 만 종료코드 n 으로 실패 (예: OOM 137)
#   FAKE_RUN_REPORT_OUTPUT=<문자열>  --report-path 가 있는 docker run(Gitleaks)만 이 내용을 출력
#   compose (scan-app): FAKE_COMPOSE_UP_RC=<n> up 종료코드 · FAKE_COMPOSE_EXEC_OUTPUT exec 출력(기본 isolated)
#                       FAKE_COMPOSE_RUN_FILE=<파일> run 의 stdout · FAKE_COMPOSE_RUN_RC=<n> run 종료코드
#                       run·logs 는 stderr 에 실제 MobSF 처럼 API 키를 찍는다 (마스킹 확인용)
#                       FAKE_COMPOSE_RUN_SLEEP=<초> run 이 그만큼 머문다 (중단 신호 확인용)
#   FAKE_VERSION_LABEL=<값>  빌드한 이미지의 dwk.security.version 라벨을 이 값으로 (탭·줄바꿈 정리 확인용)
#   compose: FAKE_COMPOSE_DOWN_RC=<n> down 종료코드 (스택을 내리지 못한 경우)
#   compose (scan-web): run --entrypoint python3 (격리 확인)은 FAKE_COMPOSE_ISO_OUTPUT(기본 isolated)를 낸다
#                       FAKE_COMPOSE_LOGS_FILE=<파일> logs 출력 (프록시 로그) · FAKE_COMPOSE_LOGS_RC=<n> logs 종료코드
#                       FAKE_COMPOSE_RUN_STDERR_FILE=<파일> run(스캔)의 stderr (ZAP 진행 로그)
#   남은 스택 정리: FAKE_PS_IDS=<id ...> docker ps -aq · FAKE_INSPECT_LINES=<파일> docker inspect 출력(프로젝트 시각)
#                   FAKE_VOLUMES=<이름 ...> docker volume ls -q (label=…project=<p> 로 거르면 vol-<p>) · FAKE_VOLUME_LINES=<파일> docker volume inspect 출력
#                   FAKE_SYSTEM_TIME=<RFC3339> docker info .SystemTime (빈 값이면 출력 없음)
#                   FAKE_NETWORKS=<id ...> docker network ls -q · FAKE_NETWORK_LINES=<파일> docker network inspect 출력
[ -n "${FAKE_LOG:-}" ] && echo "docker $*" >>"$FAKE_LOG"
case "$1" in
  info)
    [ "${FAKE_INFO_FAIL:-0}" = 1 ] && exit 1
    case "$*" in
      *MemTotal*) echo "${FAKE_MEM-8589934592}" ;;
      *SystemTime*) [ -n "${FAKE_SYSTEM_TIME-x}" ] && echo "${FAKE_SYSTEM_TIME-2026-11-15T12:00:00.123456789+09:00}" ;;
      *) echo ok ;;
    esac
    ;;
  compose)
    [ -n "${FAKE_COMPOSE-2.29.0}" ] || exit 1
    sub=""
    for a in "$@"; do
      case "$a" in up | run | exec | down | logs | ps | version) sub=$a; break ;; esac
    done
    case "$sub" in
      up) exit "${FAKE_COMPOSE_UP_RC:-0}" ;;
      exec) echo "${FAKE_COMPOSE_EXEC_OUTPUT-isolated}" ;;
      run)
        case "$*" in *"--entrypoint python3"*)
          echo "${FAKE_COMPOSE_ISO_OUTPUT-isolated}"
          exit 0
          ;;
        esac
        if [ -n "${FAKE_COMPOSE_RUN_STDERR_FILE:-}" ]; then cat "$FAKE_COMPOSE_RUN_STDERR_FILE" >&2; else
          echo "REST API Key: ${DWK_MOBSF_API_KEY:-}" >&2
          echo "mobsf_client: 가짜 실행" >&2
        fi
        if [ -n "${FAKE_COMPOSE_RUN_SLEEP:-}" ]; then
          # 테스트가 정확히 이 프로세스만 정리할 수 있게 pid 를 남긴다 (3차 리뷰 NT2)
          sleep "$FAKE_COMPOSE_RUN_SLEEP" &
          [ -n "${FAKE_RUN_PIDFILE:-}" ] && echo $! >>"$FAKE_RUN_PIDFILE"
          wait $!
        fi
        [ -n "${FAKE_COMPOSE_RUN_FILE:-}" ] && cat "$FAKE_COMPOSE_RUN_FILE"
        exit "${FAKE_COMPOSE_RUN_RC:-0}"
        ;;
      logs)
        if [ -n "${FAKE_COMPOSE_LOGS_FILE:-}" ]; then cat "$FAKE_COMPOSE_LOGS_FILE"; else
          echo "REST API Key: ${DWK_MOBSF_API_KEY:-} secret=${DWK_MOBSF_SECRET:-}"; fi
        exit "${FAKE_COMPOSE_LOGS_RC:-0}"
        ;;
      down) exit "${FAKE_COMPOSE_DOWN_RC:-0}" ;;
      ps) exit 0 ;;
      *) echo "${FAKE_COMPOSE-2.29.0}" ;;
    esac
    ;;
  version) echo "${FAKE_COMPONENTS-Engine containerd runc docker-init }" ;;
  context) echo "fake" ;;
  image)
    ref=${!#}
    if [ -n "${FAKE_BUILD_STATE:-}" ] && [ -f "$FAKE_BUILD_STATE" ]; then
      while read -r t i l v; do
        if [ "$ref" = "$t" ] || [ "$ref" = "$i" ]; then
          case "$*" in
            *'{{.Id}}'*) echo "$i" ;;
            *build-input*) echo "$l" ;;
            *dwk.security.version*) printf '%s\n' "${FAKE_VERSION_LABEL-$v}" ;;
            *'{{.Size}}'*) echo 9000000 ;;
          esac
          exit 0
        fi
      done <"$FAKE_BUILD_STATE"
    fi
    for r in ${FAKE_IMAGES:-}; do [ "$r" = "$ref" ] && exit 0; done
    exit 1
    ;;
  build)
    if [ "${FAKE_BUILD_RC:-0}" != 0 ]; then
      echo "ERROR: unable to select packages: tinyproxy-1.11.3-r0 (no such package)" >&2
      exit "$FAKE_BUILD_RC"
    fi
    tag="" label="" version="" iid=""
    prev=""
    for a in "$@"; do
      [ "$prev" = -t ] && tag=$a
      [ "$prev" = --iidfile ] && iid=$a
      if [ "$prev" = --label ]; then
        case "$a" in
          dwk.security.build-input=*) label=${a#*=} ;;
          dwk.security.version=*) version=${a#*=} ;;
        esac
      fi
      prev=$a
    done
    id=${FAKE_BUILD_ID:-sha256:$(printf 'b%.0s' $(seq 64))}
    echo "$tag $id ${FAKE_BUILD_LABEL:-$label} ${version:--}" >>"${FAKE_BUILD_STATE:?}"
    [ -n "$iid" ] && [ "${FAKE_BUILD_NO_IIDFILE:-0}" != 1 ] && printf '%s' "$id" >"$iid"
    echo "$id"
    ;;
  run)
    if [ -n "${FAKE_RUN_FAIL_MATCH:-}" ]; then
      case "$*" in *"$FAKE_RUN_FAIL_MATCH"*)
        echo "가짜 실패" >&2
        exit "${FAKE_RUN_FAIL_RC:-1}"
        ;;
      esac
    fi
    case "$*" in *--report-path*)
      if [ -n "${FAKE_RUN_REPORT_OUTPUT+x}" ]; then
        printf '%s' "$FAKE_RUN_REPORT_OUTPUT"
        echo "INF scanned ~10 bytes" >&2
        exit 0
      fi
      ;;
    esac
    if [ -n "${FAKE_RUN_OUTPUT+x}" ]; then
      printf '%s' "$FAKE_RUN_OUTPUT"
      exit 0
    fi
    echo "가짜 docker 로 run 을 실행하면 안 됩니다" >&2
    exit 99
    ;;
  ps)
    # shellcheck disable=SC2086  # 공백으로 구분한 목록을 한 줄씩 낸다
    [ -n "${FAKE_PS_IDS:-}" ] && printf '%s\n' $FAKE_PS_IDS
    ;;
  inspect)
    case "$*" in
      *OOMKilled*) echo false ;;
      *) [ -n "${FAKE_INSPECT_LINES:-}" ] && cat "$FAKE_INSPECT_LINES" ;;
    esac
    ;;
  volume)
    case "$2" in
      ls)
        args="$*"
        case "$args" in
          # 프로젝트 하나로 거른 목록 — 그 프로젝트의 볼륨 이름만 낸다
          *label=com.docker.compose.project=*) echo "vol-${args##*label=com.docker.compose.project=}" ;;
          *)
            # shellcheck disable=SC2086  # 공백으로 구분한 목록을 한 줄씩 낸다
            [ -n "${FAKE_VOLUMES:-}" ] && printf '%s\n' $FAKE_VOLUMES
            ;;
        esac
        ;;
      inspect) [ -n "${FAKE_VOLUME_LINES:-}" ] && cat "$FAKE_VOLUME_LINES" ;;
    esac
    ;;
  network)
    # shellcheck disable=SC2086  # 공백으로 구분한 목록을 한 줄씩 낸다
    case "$2" in
      ls) [ -n "${FAKE_NETWORKS:-}" ] && printf '%s\n' $FAKE_NETWORKS ;;
      inspect) [ -n "${FAKE_NETWORK_LINES:-}" ] && cat "$FAKE_NETWORK_LINES" ;;
    esac
    exit 0
    ;;
  pull) echo "가짜 docker 로 $1 을 실행하면 안 됩니다" >&2; exit 99 ;;
  *) exit 0 ;;
esac
