    {"tool": "semgrep", "rule_suffix": "bad-certificate-callback", "file": "lib/api.dart", "severity": "high", "note": "F4"},
    {"tool": "semgrep", "rule_suffix": "insecure-http-url", "file": "lib/api.dart", "note": "F4"},
    {"tool": "semgrep", "rule_suffix": "flutter.insecure-storage", "file": "lib/api.dart", "note": "F5"},
    {"tool": "osv-scanner", "package": "dio@4.0.0", "file": "pubspec.lock", "note": "F6"},
    {"tool": "toolkit", "rule_id": "android.manifest-debuggable", "file": "android/app/src/main/AndroidManifest.xml", "note": "네이티브 하위 경로"},
    {"tool": "toolkit", "rule_id": "ios.ats-arbitrary-loads", "file": "ios/Runner/Info.plist", "note": "네이티브 하위 경로"}
