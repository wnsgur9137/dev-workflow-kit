    {"tool": "toolkit", "rule_id": "ios.ats-insecure-http-exception", "file": "App/Info.plist", "note": "I2"},
    {"tool": "toolkit", "rule_id": "ios.ats-weak-tls", "file": "App/Info.plist", "note": "I2"},
