    {"tool": "semgrep", "rule_suffix": "webview-file-access", "file": "App/Sources/Web.swift", "note": "I7"},
    {"tool": "osv-scanner", "package": "github.com/apple/swift-nio-http2@1.19.1", "file": "Package.resolved", "note": "I5"}
