    {"tool": "toolkit", "rule_id": "ios.ats-arbitrary-loads", "file": "App/Info.plist", "severity": "high", "note": "I2"},
    {"tool": "toolkit", "rule_id": "ios.ats-insecure-http-exception", "file": "App/Info.plist", "note": "I2"},
    {"tool": "toolkit", "rule_id": "ios.ats-weak-tls", "file": "App/Info.plist", "note": "I2"},
    {"tool": "semgrep", "rule_suffix": "insecure-storage", "file": "App/Sources/Session.swift", "note": "I3"},
    {"tool": "semgrep", "rule_suffix": "sensitive-log", "file": "App/Sources/Session.swift", "note": "I4"},
    {"tool": "semgrep", "rule_suffix": "sensitive-log-objc", "file": "App/Legacy/Crypto.m", "note": "I4 Objective-C"},
    {"tool": "semgrep", "rule_suffix": "weak-crypto", "file": "App/Sources/Hash.swift", "note": "I6"},
