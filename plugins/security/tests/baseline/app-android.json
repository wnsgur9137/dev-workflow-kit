    {"tool": "mobsf", "rule_id": "mobsf.manifest.clear-text-traffic", "severity": "high"},
    {"tool": "mobsf", "rule_id": "mobsf.network.cleartext", "severity": "high"},
    {"tool": "mobsf", "rule_id": "mobsf.network.user-certs", "severity": "high"},
    {"tool": "mobsf", "rule_id": "mobsf.code.android-md5", "file": "com/example/vulnapp/MainActivity.java"},
    {"tool": "mobsf", "rule_id": "mobsf.code.android-hardcoded"},
    {"tool": "mobsf", "rule_id": "mobsf.secret.hardcoded", "severity": "high", "package": "google_api_key"}
  ],
  "must_not_find": [
    {"tool": "mobsf", "rule_prefix": "mobsf.macho."},
    {"tool": "mobsf", "rule_prefix": "mobsf.ats."}
  ]
